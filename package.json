{
  "name": "geke-launcher",
  "version": "1.0.0",
  "description": "Raycast-style macOS app launcher built with Electron and Vite.",
  "author": "Smithereensun",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "app:dev": "NODE_ENV=development concurrently -k \"vite\" \"wait-on tcp:5173 && electron .\"",
    "app:build": "npm run build && electron-builder"
  },
  "dependencies": {
    "pinyin-pro": "^3.27.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12",
    "vite": "^7.1.1",
    "wait-on": "^8.0.5"
  },
  "build": {
    "appId": "com.smithereensun.geke",
    "productName": "极刻 GEKE",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "target": [
        "dir",
        "zip"
      ],
      "artifactName": "GEKE-${version}-${arch}.${ext}"
    }
  }
}
